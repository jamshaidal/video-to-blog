NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_video_platform
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
APP_BASE_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=your_secret_key_here
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_CONTENT_MODEL=gpt-4.1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=ai-video-platform
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_PUBLIC_ENDPOINT=http://localhost:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_S3_AUTO_CREATE_BUCKET=true
MAX_FILE_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=300
MAX_DAILY_UPLOADS_PER_USER=3
WORKER_CONCURRENCY=2
CORS_ORIGIN=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MotionCraftAI <no-reply@fuvideo.site>
TRUST_PROXY=false
ENABLE_EMBEDDED_WORKER=true
